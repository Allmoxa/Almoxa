# Copie para .env e preencha com as credenciais do seu projeto.
# No Vercel, cadastre estas mesmas variaveis em Settings > Environment Variables.

# --- Supabase (client, embutidas no bundle do navegador) ---
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase (servidor / SSR) ---
SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Google Gemini: obrigatoria para a leitura de foto/nota ---
# Gere em https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Supabase service role: obrigatoria para o painel Admin ---
# Usada por src/integrations/supabase/client.server.ts (supabaseAdmin) para criar
# usuarios e ler o estoque de qualquer conta. Nunca exponha no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Resend: obrigatoria para o formulario "Fale conosco" da home ---
# Gere em https://resend.com/api-keys
RESEND_API_KEY="re_..."
# E-mail que recebe as mensagens do formulario. No plano gratis do Resend sem
# dominio verificado, so pode ser o mesmo e-mail da conta Resend.
CONTACT_EMAIL_TO="voce@example.com"

# --- Portao temporario na frente da home publica (ver src/components/site-gate.tsx) ---
# Nao e autenticacao de verdade, so afasta visita casual antes do lancamento.
SITE_GATE_USER=""
SITE_GATE_PASSWORD=""

# --- Almoxa Agenda ---
# A Agenda faz parte deste app (rotas /agenda, /a/<slug>, /agendamento/<token>),
# entao nao ha URL pra configurar. O que ela precisa:
#
# RESEND_API_KEY nao se repete aqui de proposito: e a mesma chave do formulario
# "Fale conosco", ja definida la em cima. Num arquivo .env a ultima linha vence,
# entao repetir a chave vazia aqui desligaria o e-mail do app inteiro em quem
# copiasse este modelo e preenchesse so a primeira.
AGENDA_EMAIL_FROM="Almoxa Agenda <onboarding@resend.dev>"
# Opcional: dominio proprio da agenda. Entra em todo link de e-mail e no
# endereco que a tela "Seu link" manda copiar. Vazio, o app usa sozinho o
# dominio de producao do projeto na Vercel (ex.: almoxa.vercel.app), que
# vale inclusive quando o codigo roda num deploy de branch. Valor que nao
# for endereco de verdade e recusado e registrado no log -- nao adianta
# deixar o exemplo abaixo aqui.
AGENDA_PUBLIC_URL=""       # ex.: https://agenda.seusalao.com.br
CRON_SECRET=""             # autoriza /api/cron/lembretes; vazio = lembrete nao sai
                           # So ASCII: vira valor de header, e acento derruba o deploy.
                           # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
