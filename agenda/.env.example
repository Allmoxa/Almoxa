# Copie para .env e preencha com as credenciais do seu projeto.
# No Vercel, cadastre estas mesmas variaveis em Settings > Environment Variables.

# --- Supabase (client, embutidas no bundle do navegador) ---
VITE_SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase (servidor / SSR) ---
SUPABASE_URL="https://SEU_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase service role ---
# O agendamento publico nao tem login: quem grava e le horario livre e o
# servidor, com esta chave. Nunca exponha no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Resend: obrigatoria para confirmacao e lembrete por e-mail ---
# Gere em https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Remetente. No plano gratis sem dominio verificado, use onboarding@resend.dev.
AGENDA_EMAIL_FROM="Almoxa Agenda <onboarding@resend.dev>"

# --- URL publica da agenda ---
# Entra nos links de confirmacao/cancelamento e na assinatura de calendario.
# Em producao, o endereco real (https://agenda.seudominio.com).
AGENDA_PUBLIC_URL="http://localhost:8081"

# --- Cron de lembretes ---
# Segredo que autoriza /api/cron/lembretes. O Vercel Cron manda automaticamente
# o header Authorization: Bearer <CRON_SECRET>; gere um valor longo e aleatorio.
CRON_SECRET=""

# --- Link interno de volta para o Almoxa (integracao entre os dois sistemas) ---
# Vazio esconde o atalho no menu.
ALMOXA_APP_URL=""
VITE_ALMOXA_APP_URL=""
